/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "open-beans",
	"compatibility_date": "2026-07-30",
	"main": "./workers/app.ts",
	// Only serve on the custom domain; never re-enable workers.dev on deploy.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "open-beans-db",
			"database_id": "24546312-5f82-487a-bbf4-ce8c751c7872",
			"migrations_dir": "./drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "open-beans-images"
		}
	]
}
